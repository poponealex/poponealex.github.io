---
import type { Certification } from '../data/certifications';

/** Native certification card — dark-mode aware, unlike the Credly embeds it replaces. */
interface Props {
  certification: Certification;
}

const { certification }: Props = Astro.props;
const { name, issuer, level, year, isNew } = certification;
---

<li
  class="border-line bg-surface flex flex-col justify-between gap-6 rounded-xl border p-5"
  data-reveal
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-eyebrow text-ink-faint font-mono uppercase">{level}</p>
    {
      isNew && (
        <p class="text-eyebrow bg-accent-wash text-accent rounded-full px-2 py-0.5 font-mono uppercase">
          New
        </p>
      )
    }
  </div>

  <div>
    <h3 class="font-display text-lg leading-tight font-semibold tracking-tight text-balance">
      {name}
    </h3>
    <p class="text-eyebrow text-ink-muted mt-3 flex justify-between gap-3 font-mono uppercase">
      <span>{issuer}</span>
      <span class="text-ink-faint">{year}</span>
    </p>
  </div>
</li>
