---
/**
 * Two-state theme control: light ⇄ dark, starting from the system preference.
 *
 * A third `system` state was misleading — the monitor icon read as a mode of its
 * own, and returning to light could take three clicks. The system preference is
 * still the default; it is just where you start rather than somewhere you cycle
 * back to. Touch it once and the choice sticks.
 *
 * Plain DOM rather than a framework island — the whole behaviour is ~25 lines,
 * so shipping React for it would cost ~45 KB for no benefit. The `<html>` class
 * is set pre-paint by the inline script in Base.astro, so neither the theme nor
 * this button's icon ever flashes.
 */
---

<button
  type="button"
  data-theme-toggle
  class="text-ink-muted hover:bg-accent-wash hover:text-accent grid size-9 place-items-center rounded-md transition-colors"
  aria-label="Change colour theme"
>
  <svg
    class="theme-icon theme-icon-light size-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
    ></path>
  </svg>
  <svg
    class="theme-icon theme-icon-dark size-[18px]"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
  </svg>
</button>

<script>
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  /** True while no explicit choice is stored, so the OS still drives the theme. */
  function followsSystem(): boolean {
    const stored = localStorage.getItem('theme');
    return stored !== 'light' && stored !== 'dark';
  }

  /** Resolve the active theme: the stored choice if there is one, else the OS. */
  function isDark(): boolean {
    return followsSystem() ? systemDark.matches : localStorage.getItem('theme') === 'dark';
  }

  /** Apply a theme to the document and mirror it onto every toggle button. */
  function apply(dark: boolean): void {
    document.documentElement.classList.toggle('dark', dark);
    const label = dark ? 'Theme: dark. Activate for light.' : 'Theme: light. Activate for dark.';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', label);
      button.setAttribute('aria-pressed', String(dark));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = !isDark();
      localStorage.setItem('theme', next ? 'dark' : 'light');
      apply(next);
    });
  });

  // Track OS changes live, but only until the visitor picks a side.
  systemDark.addEventListener('change', () => {
    if (followsSystem()) apply(systemDark.matches);
  });

  apply(isDark());
</script>
