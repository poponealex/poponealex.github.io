---
import Container from './Container.astro';
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-section border-line border-t">
  <Container class="flex flex-col gap-8 py-12 sm:flex-row sm:justify-between">
    <div>
      <p class="font-display text-lg font-semibold tracking-tight">{site.name}</p>
      <p class="text-eyebrow text-ink-faint mt-1 font-mono uppercase">
        {site.role} &middot; {site.location}
      </p>
    </div>

    <nav aria-label="Elsewhere" class="flex flex-col gap-2 sm:items-end">
      {
        socials.map((social) => (
          <a
            href={social.href}
            class="link-sweep text-ink-muted hover:text-accent w-fit font-mono text-sm transition-colors"
            rel={social.href.startsWith('mailto:') ? undefined : 'me noopener'}
          >
            {social.handle}
          </a>
        ))
      }
    </nav>
  </Container>

  <Container class="border-line flex flex-col gap-2 border-t py-6 sm:flex-row sm:justify-between">
    <p class="text-eyebrow text-ink-faint font-mono">&copy; {year} {site.name}</p>
    <p class="text-eyebrow text-ink-faint font-mono">
      Built with <a
        href="https://astro.build"
        class="link-sweep hover:text-accent transition-colors"
        rel="noopener">Astro</a
      >
    </p>
  </Container>
</footer>
