---
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interTightLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { site, socialCard } from '../data/site';
import { buildGraph, serialiseGraph, type ArticleSchema, type PageSchemaType } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Set on the home page so the title is not suffixed with the site name. */
  isHome?: boolean;
  /** Overrides the JSON-LD page node type. The home page derives its own. */
  schemaType?: PageSchemaType;
  /** Present on article pages, which additionally emit a `BlogPosting` node. */
  article?: ArticleSchema;
  /** Set on pages that are not real content, such as the 404. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  isHome = false,
  schemaType,
  article,
  noindex = false,
} = Astro.props;

const pageTitle = !title || isHome ? `${site.name} — ${site.role}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(`${socialCard.path}?v=${socialCard.version}`, site.url);

/** `profile` and `article` genuinely describe those pages; the rest are plain pages. */
const ogType = article ? 'article' : isHome ? 'profile' : 'website';

// The profile tags take the name in parts. Split here rather than stored separately,
// so the parts cannot drift from `site.name`.
const [profileFirstName, ...surname] = site.name.split(' ');
const profileLastName = surname.join(' ');

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// A non-indexable page describes no entity and owns no URL: the 404 file is served
// for every unknown path, so any canonical it named would be a page that is not
// the one being viewed.
const jsonLd = noindex
  ? undefined
  : serialiseGraph(
      await buildGraph({
        canonical: canonical.href,
        pathname: Astro.url.pathname,
        pageTitle,
        title,
        description,
        imageUrl: ogImage.href,
        schemaType: schemaType ?? (isHome ? 'ProfilePage' : 'WebPage'),
        article,
      })
    );
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* The stylesheet is a separate file, so fonts go undiscovered until it parses. */}
    {/* Mono is omitted: it sets only small labels, and a third preload would compete. */}
    <link
      rel="preload"
      href={interTightLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writing`}
      href="/rss.xml"
    />

    <meta name="author" content={site.name} />
    {/* Indexing is already the default; this is here to lift the preview size caps. */}
    <meta name="robots" content={robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(socialCard.width)} />
    <meta property="og:image:height" content={String(socialCard.height)} />
    <meta property="og:image:alt" content={socialCard.alt} />

    {
      isHome && (
        <>
          <meta property="profile:first_name" content={profileFirstName} />
          <meta property="profile:last_name" content={profileLastName} />
        </>
      )
    }

    {
      article && (
        <>
          <meta property="article:published_time" content={article.pubDate.toISOString()} />
          <meta
            property="article:modified_time"
            content={(article.updatedDate ?? article.pubDate).toISOString()}
          />
          <meta property="article:author" content={`${site.url}/`} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={socialCard.alt} />

    <meta name="theme-color" content="#FBFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C1013" media="(prefers-color-scheme: dark)" />

    {/* .ico first for the browsers and crawlers that request /favicon.ico blind. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    {/* Resolve the theme before first paint so there is never a flash of the wrong one. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        // Gates the reveal-on-scroll styles, so no-JS visitors get visible content.
        document.documentElement.classList.add('js');
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="focus-visible:bg-accent focus-visible:text-accent-ink sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-[100] focus-visible:rounded-md focus-visible:px-4 focus-visible:py-2 focus-visible:font-mono focus-visible:text-sm"
    >
      Skip to content
    </a>

    <Nav />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Reveal-on-scroll. Skipped wholesale when the user prefers reduced motion,
      // in which case the CSS leaves elements visible with no transition.
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        targets.forEach((target) => observer.observe(target));
      }
    </script>
  </body>
</html>
