---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

/**
 * The three links plus the toggle fit on a 320px viewport, so there is no burger menu.
 * Below `sm` the mark stands alone — the full name plus the links overflows a 320px
 * header, and the mark now carries the identity the initials used to stand in for.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-line bg-paper/85 sticky top-0 z-50 border-b backdrop-blur-md">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="text-ink hover:text-accent flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight transition-colors"
      aria-label={`${site.name} — home`}
    >
      {/* Hairline because the mark's own background is the dark theme's paper. */}
      <img
        src="/favicon.svg"
        alt=""
        width="20"
        height="20"
        class="ring-line size-5 shrink-0 rounded-sm ring-1"
      />
      <span class="hidden whitespace-nowrap sm:inline" aria-hidden="true">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
      {
        nav.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-sm transition-colors sm:px-3',
              isCurrent(link.href) ? 'text-accent' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <span class="bg-line mx-1 h-5 w-px" aria-hidden="true"></span>
      <ThemeToggle />
    </nav>
  </Container>
</header>
